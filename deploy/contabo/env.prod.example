# SIREN — variables de PRODUCTION (modèle SANS valeur réelle).
# Copier en deploy/contabo/.env.prod sur le serveur (chmod 600, propriétaire deploy).
# Ne JAMAIS committer .env.prod (ignoré par Git). Générer chaque secret avec :
#   openssl rand -base64 48 | tr -d '\n=/+' | cut -c1-48

# --- Déploiement ---------------------------------------------------------------
SIREN_VERSION=v0.0.0-exemple
SIREN_IMAGE_PREFIX=ghcr.io/exemple/siren
DOMAIN=api.exemple.cm
CADDY_EMAIL=exploitation@exemple.cm

# --- Base de données ---------------------------------------------------------------
# Propriétaire du schéma (migrations, sauvegardes) — superutilisateur de l'image.
POSTGRES_USER=siren
POSTGRES_PASSWORD=a-remplacer-par-un-secret-fort-48-caracteres-min
POSTGRES_DB=siren
# Rôle applicatif (lecture/écriture des données uniquement), créé par deploy.sh.
APP_DB_USER=siren_app
APP_DB_PASSWORD=a-remplacer-par-un-autre-secret-fort-48-caracteres

# --- Application -----------------------------------------------------------------
SECRET_KEY=a-remplacer-par-un-secret-fort-de-48-caracteres-minimum
JWT_SECRET_KEY=a-remplacer-par-un-autre-secret-fort-de-48-caracteres
ALLOWED_ORIGINS=https://api.exemple.cm
TRUST_PROXY_HEADERS=true
PHONE_DEFAULT_REGION=CM

# Codes à usage unique : « live » = vrais fournisseurs (au moins un canal requis).
OTP_MODE=live
# SMS : « twilio » ou « africastalking » (laisser vide si aucun contrat).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# WhatsApp Cloud API (modèle « authentication » approuvé).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
# E-mail (SMTP).
EMAIL_BACKEND=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Commandes vers le traceur (vide = aucun canal : commandes FAILED, jamais prétendues envoyées).
DEVICE_COMMAND_CHANNEL=
DEVICE_COMMAND_SIGNING_KEY=

# Observabilité (facultatif).
SENTRY_DSN=

# --- Sauvegardes ---------------------------------------------------------------
BACKUP_DIR=/var/backups/siren
# Clé publique age (https://age-encryption.org) : sauvegardes chiffrées. Vide = non chiffrées (déconseillé).
BACKUP_AGE_RECIPIENT=
# Copie hors site (rclone, remote configuré à part) — vide = aucune copie hors site.
BACKUP_RCLONE_REMOTE=
