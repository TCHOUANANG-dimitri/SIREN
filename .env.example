# ==============================================================================
# SIREN - MODÈLE DE VARIABLES D'ENVIRONNEMENT & CLÉS API (.env.example)
# IMPORTANT: Copiez ce fichier sous le nom '.env' et complétez les valeurs.
# NE JAMAIS COMMITER LE FICHIER '.env' CONTENANT VOS VRAIES CLÉS API SUR GITHUB !
# ==============================================================================

# 1. Mode d'exécution de l'API ('mock' ou 'live')
EXPO_PUBLIC_API_MODE=mock

# 2. URL de base du Backend SIREN REST & WebSocket
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws

# 3. Clé API Cartographique (Google Maps Android & iOS)
# Obtenez votre clé sur https://console.cloud.google.com/ (Activer Maps SDK for Android/iOS)
EXPO_PUBLIC_MAPS_API_KEY=VOTRE_CLE_API_GOOGLE_MAPS_ICI

# 4. Clé API Service de Traduction Dynamique (DeepL API / Google Translate API)
# Obtenez votre clé sur https://www.deepl.com/pro-api ou Google Cloud Translation
EXPO_PUBLIC_TRANSLATION_API_KEY=VOTRE_CLE_API_TRADUCTION_ICI
