# ==============================================================================
# SIREN — Application mobile — variables d'environnement (.env.example)
# Copier en `.env` puis compléter. Ne JAMAIS commiter `.env` (déjà ignoré par Git).
# Toute variable EXPO_PUBLIC_* est embarquée dans l'APK : n'y mettez aucun secret.
# Validation au démarrage : src/config/env.ts (écran explicite si la config est inutilisable).
# ==============================================================================

# Environnement de build : development | staging | production
# En production, le mode mock est refusé.
EXPO_PUBLIC_APP_ENV=development

# Source des données : mock (backend simulé, développement) | live (serveur SIREN)
EXPO_PUBLIC_API_MODE=mock

# Serveur SIREN (mode live). HTTPS obligatoire hors poste local.
#   Émulateur Android → serveur local : http://10.0.2.2:8000
#   o2switch : https://<sous-domaine-api>  (accès fournis ultérieurement)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Temps réel. WSS obligatoire hors poste local.
# LAISSER VIDE sur o2switch mutualisé (Passenger ne gère pas le WebSocket) → polling REST.
EXPO_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Fonctions optionnelles (true/false). Par défaut : websocket=true (si URL), faucon=true,
# credits=false, ads=false, audio=false en live (cadre juridique à valider).
EXPO_PUBLIC_FEATURE_WEBSOCKET=
EXPO_PUBLIC_FEATURE_CREDITS=
EXPO_PUBLIC_FEATURE_ADS=
EXPO_PUBLIC_FEATURE_AUDIO=
EXPO_PUBLIC_FEATURE_FAUCON=

# Cartes : MapLibre + tuiles OpenStreetMap (OpenFreeMap), sans clé.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optionnelle, inutilisée par le moteur de carte actuel.
EXPO_PUBLIC_MAPS_API_KEY=

# Passerelle GPS tierce transitoire (WebView). Vide = masquée.
EXPO_PUBLIC_FAUCON_URL=https://faucon.169.58.69.36.sslip.io/

# Observabilité (optionnel) — DSN public Sentry, branché quand le SDK sera ajouté.
EXPO_PUBLIC_SENTRY_DSN=

# Traduction dynamique (optionnel, non nominal : FR/EN sont complets dans l'app).
EXPO_PUBLIC_TRANSLATION_API_KEY=

# Push Android (FCM) : chemin du google-services.json (hors Git). Défaut : ./google-services.json
# GOOGLE_SERVICES_JSON=./google-services.json
