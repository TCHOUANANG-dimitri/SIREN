{
    # Email ACME (Let's Encrypt / ZeroSSL). Sur localhost, Caddy utilise
    # automatiquement son CA interne et ne contacte aucun fournisseur.
    email {$CADDY_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
    # API, healthcheck, Swagger et WebSockets -> FastAPI
    # (Caddy gère la négociation WebSocket nativement avec reverse_proxy)
    @api {
        path /api/* /health /docs /redoc /openapi.json /ws/*
    }

    reverse_proxy @api api:8000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header / {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Access logs -> stdout (capturés par docker logs)
    log {
        output stdout
        format json
    }
}
