# =============================================================================
# SIREN — Serveur — configuration Docker Compose (exemple SANS secret réel)
#   cp .env.docker.example .env      puis remplacer chaque valeur « a-remplacer »
# Les URL de base de données, Redis et Celery sont construites par
# docker-compose.yml à partir des variables POSTGRES_* : ne pas les mettre ici.
# =============================================================================

# --- Base PostgreSQL/PostGIS (service db) ---
POSTGRES_USER=siren
POSTGRES_DB=siren
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=a-remplacer

# --- Application ---
PROJECT_NAME=SIREN
VERSION=1.0.0
# development | staging | production — hors development, le serveur REFUSE de
# démarrer avec des secrets faibles ou d'exemple.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Générer chacun : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer
JWT_SECRET_KEY=a-remplacer
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:8081
DEFAULT_TIMEZONE=Africa/Douala
POSITION_RETENTION_DAYS=90

# --- Ports publiés sur l'hôte ---
SIREN_API_PORT=8000

# --- Reverse proxy Caddy (HTTPS automatique) ---
DOMAIN=localhost
CADDY_EMAIL=admin@example.com

# --- OTP et emails (voir docs/EMAILS.md) ---
OTP_MODE=
DEV_OTP_CODE=123456
EMAIL_BACKEND=disabled
EMAIL_FROM=
EMAIL_FROM_NAME=SIREN
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# --- Push (Firebase) : fichier de compte de service monté hors Git ---
FCM_CREDENTIALS_PATH=/app/firebase-credentials.json

# --- Divers ---
SENTRY_DSN=
AUDIO_ENABLED=false
