# =============================================================================
# SIREN — Serveur — configuration Docker Compose (exemple SANS secret réel)
#   cp .env.docker.example .env      puis remplacer chaque valeur « a-remplacer »
# Les URL de base de données, Redis et Celery sont construites par
# docker-compose.yml à partir des variables POSTGRES_* : ne pas les mettre ici.
# =============================================================================

# --- Base PostgreSQL/PostGIS (service db) ---
POSTGRES_USER=siren
POSTGRES_DB=siren
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=a-remplacer

# --- Application ---
PROJECT_NAME=SIREN
VERSION=1.0.0
# development | staging | production — hors development, le serveur REFUSE de
# démarrer avec des secrets faibles ou d'exemple.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Générer chacun : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer
JWT_SECRET_KEY=a-remplacer
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:8081
DEFAULT_TIMEZONE=Africa/Douala
POSITION_RETENTION_DAYS=90

# --- Ports publiés sur l'hôte ---
SIREN_API_PORT=8000

# --- Reverse proxy Caddy (HTTPS automatique) ---
DOMAIN=localhost
CADDY_EMAIL=admin@example.com

# --- OTP et emails (voir docs/EMAILS.md) ---
OTP_MODE=
DEV_OTP_CODE=123456
EMAIL_BACKEND=disabled
EMAIL_FROM=
EMAIL_FROM_NAME=SIREN
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# --- Push (Firebase) : fichier de compte de service monté hors Git ---
FCM_CREDENTIALS_PATH=/app/firebase-credentials.json

# --- Divers ---
SENTRY_DSN=
AUDIO_ENABLED=false

# --- Codes à usage unique : canaux et limites (app/services/otp.py, otp_delivery.py) ---
# Code alphanumérique (sans 0/O, 1/I/L), 4 à 6 caractères.
OTP_LENGTH=6
OTP_MAX_PER_DESTINATION_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
OTP_HTTP_TIMEOUT_S=10
# Région par défaut des numéros saisis sans indicatif (ISO 3166-1 alpha-2).
PHONE_DEFAULT_REGION=CM
# SMS : « twilio » ou « africastalking » ; vide = canal SMS indisponible (jamais simulé).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# WhatsApp Cloud API (modèle « authentication » approuvé par Meta) ; vide = indisponible.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_GRAPH_VERSION=v21.0

# --- Limitation de débit (table rate_limit_events) ---
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_FAILURE_WINDOW_S=900
REGISTER_MAX_PER_IP_PER_HOUR=10
PAIRING_MAX_FAILURES_PER_USER=5
PAIRING_FAILURE_WINDOW_S=900
DEVICE_LOOKUP_MAX_PER_USER_PER_HOUR=30
# true UNIQUEMENT si l'API n'est joignable QUE par un mandataire de confiance (Caddy, Apache) :
# IP = dernière adresse de X-Forwarded-For. Cette pile publie aussi l'API en direct
# (SIREN_API_PORT) : laisser false, sinon X-Forwarded-For est falsifiable. La production
# (deploy/contabo/docker-compose.prod.yml) l'active elle-même, l'API n'y publiant aucun port.
TRUST_PROXY_HEADERS=false

# --- Commandes vers le traceur (protocole §8) ---
# Vide = aucun canal : toute commande est enregistrée FAILED (no_channel), jamais prétendue envoyée.
DEVICE_COMMAND_CHANNEL=
# Clé HMAC partagée avec le firmware (≥ 32 caractères si un canal est actif).
DEVICE_COMMAND_SIGNING_KEY=
DEVICE_COMMAND_TIMEOUT_S=120
