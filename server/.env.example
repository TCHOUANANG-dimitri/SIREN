# =============================================================================
# SIREN — Serveur — Variables d'environnement
# =============================================================================
# Copier en .env et ajuster les valeurs
# =============================================================================

# --- Application ---
PROJECT_NAME=SIREN
VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
# Hors développement, le serveur REFUSE de démarrer avec ces valeurs d'exemple (≥ 32 caractères requis).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changez-moi-en-production-avec-une-cle-forte
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# --- Base de données (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+asyncpg://siren:siren_password@localhost:5432/siren
DATABASE_URL_SYNC=postgresql://siren:siren_password@localhost:5432/siren

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# Mutualisé o2switch : pas de Redis -> mettre REDIS_ENABLED=false
# (pub/sub in-process + listen explicitement, Celery remplacé par run_tasks.py)
REDIS_ENABLED=true

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Firebase Cloud Messaging (push notifications) ---
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# --- Sentry (error tracking) ---
SENTRY_DSN=

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=changez-moi-aussi-en-production

# --- Caddy (reverse proxy) ---
CADDY_EMAIL=admin@example.com     # Pour TLS automatique
DOMAIN=siren.example.com

# --- Données OSM (heatmap) ---
OSM_DATA_DIR=./data/osm

# --- Rétention ---
POSITION_RETENTION_DAYS=90

# --- Temps / fuseau des horaires déclarés par les parents ---
DEFAULT_TIMEZONE=Africa/Douala

# --- OTP (vérification du téléphone, connexion en deux étapes, récupération, changement de numéro) ---
# dev      : code fixe DEV_OTP_CODE, accepté UNIQUEMENT si ENVIRONMENT=development
# disabled : étape OTP d'inscription déclarée non requise — À VALIDER par l'équipe
# live     : code aléatoire à usage unique livré par SMS, WhatsApp ou e-mail vérifié
#            (canaux ci-dessous ; « email »/« provider » = anciens noms de live)
# Vide = dev en développement, disabled ailleurs.
OTP_MODE=
DEV_OTP_CODE=123456
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_S=60
OTP_MAX_PER_HOUR=5

# --- Emails transactionnels (app/services/email) ---
# disabled (défaut) : aucun envoi ; les routes qui en dépendent répondent 503 email_unavailable
# console          : développement uniquement (email écrit dans le journal)
# smtp             : envoi réel — serveur SMTP de l'hébergeur (o2switch) ou d'un prestataire
# Les identifiants SMTP ne sont JAMAIS commités : à renseigner dans le .env du serveur.
EMAIL_BACKEND=disabled
EMAIL_FROM=
EMAIL_FROM_NAME=SIREN
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_S=15

# --- Écoute audio (étiquettes) : BLOQUÉE tant que le cadre juridique n'est pas validé ---
AUDIO_ENABLED=false

# --- Télémétrie : tolérance d'horloge du dispositif (secondes dans le futur) ---
TELEMETRY_MAX_FUTURE_SKEW_S=300

# --- Codes à usage unique : canaux et limites (app/services/otp.py, otp_delivery.py) ---
# Code alphanumérique (sans 0/O, 1/I/L), 4 à 6 caractères.
OTP_LENGTH=6
OTP_MAX_PER_DESTINATION_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
OTP_HTTP_TIMEOUT_S=10
# Région par défaut des numéros saisis sans indicatif (ISO 3166-1 alpha-2).
PHONE_DEFAULT_REGION=CM
# SMS : « twilio » ou « africastalking » ; vide = canal SMS indisponible (jamais simulé).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# WhatsApp Cloud API (modèle « authentication » approuvé par Meta) ; vide = indisponible.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_GRAPH_VERSION=v21.0

# --- Limitation de débit (table rate_limit_events) ---
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_FAILURE_WINDOW_S=900
REGISTER_MAX_PER_IP_PER_HOUR=10
PAIRING_MAX_FAILURES_PER_USER=5
PAIRING_FAILURE_WINDOW_S=900
DEVICE_LOOKUP_MAX_PER_USER_PER_HOUR=30
# Derrière UN mandataire de confiance (Caddy, Apache/Passenger) dont l'API n'est joignable
# que par lui : IP = dernière adresse de X-Forwarded-For. false si l'API est exposée en direct.
TRUST_PROXY_HEADERS=true

# --- Commandes vers le traceur (protocole §8) ---
# Vide = aucun canal : toute commande est enregistrée FAILED (no_channel), jamais prétendue envoyée.
DEVICE_COMMAND_CHANNEL=
# Clé HMAC partagée avec le firmware (≥ 32 caractères si un canal est actif).
DEVICE_COMMAND_SIGNING_KEY=
DEVICE_COMMAND_TIMEOUT_S=120
