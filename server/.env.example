# =============================================================================
# SIREN — Serveur — Variables d'environnement
# =============================================================================
# Copier en .env et ajuster les valeurs
# =============================================================================

# --- Application ---
PROJECT_NAME=SIREN
VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
# Hors développement, le serveur REFUSE de démarrer avec ces valeurs d'exemple (≥ 32 caractères requis).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changez-moi-en-production-avec-une-cle-forte
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# --- Base de données (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+asyncpg://siren:siren_password@localhost:5432/siren
DATABASE_URL_SYNC=postgresql://siren:siren_password@localhost:5432/siren

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# Mutualisé o2switch : pas de Redis -> mettre REDIS_ENABLED=false
# (pub/sub in-process + listen explicitement, Celery remplacé par run_tasks.py)
REDIS_ENABLED=true

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Firebase Cloud Messaging (push notifications) ---
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# --- Sentry (error tracking) ---
SENTRY_DSN=

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=changez-moi-aussi-en-production

# --- Caddy (reverse proxy) ---
CADDY_EMAIL=admin@example.com     # Pour TLS automatique
DOMAIN=siren.example.com

# --- Données OSM (heatmap) ---
OSM_DATA_DIR=./data/osm

# --- Rétention ---
POSITION_RETENTION_DAYS=90

# --- Temps / fuseau des horaires déclarés par les parents ---
DEFAULT_TIMEZONE=Africa/Douala

# --- OTP (confirmation d'email, vérification en deux étapes, mot de passe oublié) ---
# dev      : code fixe DEV_OTP_CODE, accepté UNIQUEMENT si ENVIRONMENT=development
# disabled : étape OTP d'inscription déclarée non requise — À VALIDER par l'équipe
# email    : code aléatoire à usage unique envoyé par email (nécessite EMAIL_BACKEND=smtp)
# Vide = dev en développement, disabled ailleurs. SMS : non implémenté (fournisseur non choisi).
OTP_MODE=
DEV_OTP_CODE=123456
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_S=60
OTP_MAX_PER_HOUR=5

# --- Emails transactionnels (app/services/email) ---
# disabled (défaut) : aucun envoi ; les routes qui en dépendent répondent 503 email_unavailable
# console          : développement uniquement (email écrit dans le journal)
# smtp             : envoi réel — serveur SMTP de l'hébergeur (o2switch) ou d'un prestataire
# Les identifiants SMTP ne sont JAMAIS commités : à renseigner dans le .env du serveur.
EMAIL_BACKEND=disabled
EMAIL_FROM=
EMAIL_FROM_NAME=SIREN
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_S=15

# --- Écoute audio (étiquettes) : BLOQUÉE tant que le cadre juridique n'est pas validé ---
AUDIO_ENABLED=false

# --- Télémétrie : tolérance d'horloge du dispositif (secondes dans le futur) ---
TELEMETRY_MAX_FUTURE_SKEW_S=300
